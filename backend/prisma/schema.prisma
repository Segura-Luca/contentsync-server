// Esquema de la base de datos. Prisma genera a partir de aquí el cliente que usa el código.
// Cada `model` es una tabla y @map indica el nombre real de la columna en MySQL.
// Al cambiar este archivo hay que crear una migración en prisma/migrations.
// ============================================================================
// ContentSync — Modelo Relacional MySQL Normalizado en 3FN
// ============================================================================

// Genera el cliente TypeScript con `npx prisma generate`.
generator client {
  provider = "prisma-client-js"
}

// Conexión a MySQL, tomada de la variable DATABASE_URL.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS DEL DOMINIO
// ----------------------------------------------------------------------------

// Roles: administrador de la plataforma, agencia de marketing y cliente.
enum RoleCode {
  ADMIN_GENERAL
  AGENCIA
  CLIENTE
}

// Proveedores de acceso social.
enum SocialProvider {
  GOOGLE
  FACEBOOK
  GITHUB
}

// Estado de la confirmación "Sí, soy yo": pendiente, confirmada o rechazada.
enum ClientConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Estado del cronograma. APPROVED significa que el cliente confirmó la semana.
enum ScheduleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  COMPLETED
}

// Tipo de pieza de contenido.
enum ContentType {
  REEL
  CAROUSEL
  STORY
  POST
  VIDEO
  OTHER
}

// Tipo de archivo adjunto.
enum MediaKind {
  IMAGE
  VIDEO
}

// Estado de revisión de un bloque por parte del cliente.
enum BlockReviewStatus {
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
}

// Etapa de producción: pendiente, grabado, editado o subido. Es el avance del trabajo de la agencia.
enum ProductionStatus {
  PENDING
  RECORDED
  EDITED
  UPLOADED
}

// Decisiones posibles del cliente al revisar un bloque.
enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// Motivos por los que se avisa a un usuario.
enum NotificationType {
  NEW_SCHEDULE
  SCHEDULE_DUPLICATED
  SCHEDULE_CONFIRMED
  BLOCK_IN_REVIEW
  BLOCK_APPROVED
  BLOCK_CHANGES_REQUESTED
  BLOCK_REJECTED
  BLOCK_COMMENT
  CLIENT_CONFIRMATION_REQUEST
  CLIENT_CONFIRMATION_RESPONSE
  IDEA_PROPOSED
  IDEA_ACCEPTED
  IDEA_REJECTED
}

// Estado de una idea propuesta por un cliente.
enum IdeaProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ----------------------------------------------------------------------------
// 1. ROLES Y USUARIOS (3FN: Rol separado en su catálogo, sin atributos redundantes)
// ----------------------------------------------------------------------------

// Catálogo de roles.
model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  code        RoleCode @unique
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

// Cuenta de acceso de cualquier persona. deletedAt marca el borrado lógico (la fila se conserva).
model User {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  roleId               String    @map("role_id") @db.VarChar(36)
  email                String    @unique @db.VarChar(180)
  // Null si la cuenta aún no tiene contraseña (acceso social o cliente recién invitado).
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  fullName             String    @map("full_name") @db.VarChar(150)
  timezone             String    @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  emailVerified        Boolean   @default(false) @map("email_verified")
  // True si debe completar sus datos al entrar (cuentas creadas con un proveedor social).
  needsProfileSetup    Boolean   @default(false) @map("needs_profile_setup")
  // Hash y vencimiento del código para verificar el correo.
  verificationToken    String?   @map("verification_token") @db.VarChar(128)
  verificationExpires  DateTime? @map("verification_expires")
  // Hash y vencimiento del código para recuperar o crear la contraseña.
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(128)
  passwordResetExpires DateTime? @map("password_reset_expires")
  // Intentos fallidos con el código actual; al llegar al máximo, el código se invalida.
  otpFailedAttempts    Int       @default(0) @map("otp_failed_attempts")
  // Token del dispositivo para notificaciones push.
  fcmToken             String?   @map("fcm_token") @db.VarChar(512)
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  role                Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  authSessions        AuthSession[]
  socialAuthAccounts  SocialAuthAccount[]
  ownedAgency         Agency?                  @relation("AgencyOwner")
  clientProfile       Client?                  @relation("ClientUser")
  createdSchedules    Schedule[]               @relation("ScheduleCreator")
  createdIdeas        ContentIdea[]            @relation("IdeaCreator")
  blockReviews        BlockReview[]
  blockComments       BlockComment[]
  confirmedSchedules  Schedule[]               @relation("ScheduleConfirmer")
  notifications       Notification[]
  auditLogs           AuditLog[]
  updatedSettings     AppSetting[]

  @@index([email])
  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

// Una sesión abierta. Cada renovación crea una fila nueva de la misma familia (tokenFamily).
model AuthSession {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @map("user_id") @db.VarChar(36)
  tokenFamily      String    @map("token_family") @db.VarChar(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceInfo       String?   @map("device_info") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  // Fecha en que este token se cambió por otro. Si vuelve a usarse, se considera robado.
  rotatedAt        DateTime? @map("rotated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("auth_sessions")
}

// Vínculo de un usuario con su cuenta en un proveedor social.
model SocialAuthAccount {
  id             String         @id @default(uuid()) @db.VarChar(36)
  userId         String         @map("user_id") @db.VarChar(36)
  provider       SocialProvider
  providerUserId String         @map("provider_user_id") @db.VarChar(180)
  email          String         @db.VarChar(180)
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
  @@map("social_auth_accounts")
}

// ----------------------------------------------------------------------------
// 2. AGENCIAS Y CLIENTES (Jerarquía multi-tenant + Confirmación "Sí, soy yo")
// ----------------------------------------------------------------------------

// Agencia de marketing, con un único usuario propietario. isSuspended bloquea sus cuentas.
model Agency {
  id           String    @id @default(uuid()) @db.VarChar(36)
  ownerUserId  String    @unique @map("owner_user_id") @db.VarChar(36)
  name         String    @db.VarChar(150)
  taxId        String    @unique @map("tax_id") @db.VarChar(40)
  contactPhone String?   @map("contact_phone") @db.VarChar(40)
  website      String?   @map("website") @db.VarChar(255)
  isSuspended  Boolean   @default(false) @map("is_suspended")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  ownerUser       User                     @relation("AgencyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  clients         Client[]
  ideaSections    ContentIdeaSection[]
  contentIdeas    ContentIdea[]
  ideaProposals   ClientIdeaProposal[]

  @@index([isSuspended])
  @@index([deletedAt])
  @@map("agencies")
}

// Marca cliente de una agencia, con un usuario propio para entrar a revisar.
model Client {
  id                    String                   @id @default(uuid()) @db.VarChar(36)
  agencyId              String                   @map("agency_id") @db.VarChar(36)
  userId                String                   @unique @map("user_id") @db.VarChar(36)
  companyName           String                   @map("company_name") @db.VarChar(150)
  industry              String?                  @db.VarChar(100)
  confirmationStatus    ClientConfirmationStatus @default(CONFIRMED) @map("confirmation_status")
  // Token del enlace del correo "Sí, soy yo", con su vencimiento.
  confirmationToken     String?                  @unique @map("confirmation_token") @db.VarChar(128)
  confirmationExpiresAt DateTime?                @map("confirmation_expires_at")
  confirmedAt           DateTime?                @map("confirmed_at")
  invitedByUserId       String?                  @map("invited_by_user_id") @db.VarChar(36)
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  deletedAt             DateTime?                @map("deleted_at")

  agency              Agency                   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user                User                     @relation("ClientUser", fields: [userId], references: [id], onDelete: Restrict)
  schedules           Schedule[]
  contentIdeas        ContentIdea[]
  ideaProposals       ClientIdeaProposal[]

  @@index([agencyId])
  @@index([confirmationStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("clients")
}

// ----------------------------------------------------------------------------
// 3. CRONOGRAMAS SEMANALES (LUNES A VIERNES), BLOQUES, FOTOS, VIDEOS Y REVISIÓN
// ----------------------------------------------------------------------------

// Cronograma de una semana para un cliente. @@unique impide dos cronogramas el mismo lunes.
model Schedule {
  id               String         @id @default(uuid()) @db.VarChar(36)
  clientId         String         @map("client_id") @db.VarChar(36)
  createdByUserId  String         @map("created_by_user_id") @db.VarChar(36)
  // Semana de origen, si esta se creó duplicando otra.
  duplicatedFromId String?        @map("duplicated_from_id") @db.VarChar(36)
  weekStartDate    DateTime       @map("week_start_date") @db.Date
  weekEndDate      DateTime       @map("week_end_date") @db.Date
  title            String         @db.VarChar(150)
  summaryNotes     String?        @map("summary_notes") @db.Text
  status           ScheduleStatus @default(IN_REVIEW)
  // Cuándo y quién confirmó la semana.
  confirmedAt      DateTime?      @map("confirmed_at")
  confirmedByUserId String?       @map("confirmed_by_user_id") @db.VarChar(36)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  client               Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser        User                     @relation("ScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser      User?                    @relation("ScheduleConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  duplicatedFrom       Schedule?                @relation("ScheduleCloneChain", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicatedChildren   Schedule[]               @relation("ScheduleCloneChain")
  items                ScheduleItem[]

  @@unique([clientId, weekStartDate])
  @@index([clientId, weekStartDate])
  @@index([status])
  @@index([confirmedByUserId])
  @@map("schedules")
}

// Bloque de contenido de un día: qué es, de qué trata, su estado de revisión y de producción.
model ScheduleItem {
  id           String            @id @default(uuid()) @db.VarChar(36)
  scheduleId   String            @map("schedule_id") @db.VarChar(36)
  dayOfWeek    Int               @map("day_of_week") // 1 (Lun) .. 5 (Vie) [soporta 1..7]
  contentType  ContentType       @default(OTHER) @map("content_type")
  blockTitle   String            @default("Bloque de contenido") @map("block_title") @db.VarChar(160)
  noteColor    String            @default("AMBER") @map("note_color") @db.VarChar(30)
  // notes: de qué trata el contenido. caption: texto que acompañará a la publicación.
  notes        String?           @db.Text
  caption      String?           @db.Text
  plannedTime  String            @default("18:00") @map("planned_time") @db.VarChar(10)
  reviewStatus BlockReviewStatus @default(IN_REVIEW) @map("review_status")
  productionStatus ProductionStatus @default(PENDING) @map("production_status")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  schedule Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  media    ScheduleItemMedia[]
  reviews  BlockReview[]
  comments BlockComment[]

  @@index([scheduleId, dayOfWeek, sortOrder])
  @@map("schedule_items")
}

// Foto o video de un bloque.
model ScheduleItemMedia {
  id             String    @id @default(uuid()) @db.VarChar(36)
  scheduleItemId String    @map("schedule_item_id") @db.VarChar(36)
  kind           MediaKind
  // Ubicación del archivo: clients/... en S3 o /uploads/videos/... en disco.
  storageKey     String    @map("storage_key") @db.VarChar(500)
  mimeType       String    @map("mime_type") @db.VarChar(60)
  sizeBytes      BigInt    @default(0) @map("size_bytes")
  originalName   String?   @map("original_name") @db.VarChar(255)
  description    String?   @db.Text
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)

  @@index([scheduleItemId, position])
  @@map("schedule_item_media")
}

// Cada decisión del cliente sobre un bloque. Se conserva el historial completo.
model BlockReview {
  id             String           @id @default(uuid()) @db.VarChar(36)
  scheduleItemId String           @map("schedule_item_id") @db.VarChar(36)
  reviewerUserId String           @map("reviewer_user_id") @db.VarChar(36)
  decision       ApprovalDecision
  feedbackNotes  String?          @map("feedback_notes") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  reviewerUser User         @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([scheduleItemId, createdAt])
  @@index([reviewerUserId])
  @@map("block_reviews")
}

// Mensaje en la conversación de un bloque.
model BlockComment {
  id             String   @id @default(uuid()) @db.VarChar(36)
  scheduleItemId String   @map("schedule_item_id") @db.VarChar(36)
  authorUserId   String   @map("author_user_id") @db.VarChar(36)
  message        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  authorUser   User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([scheduleItemId, createdAt])
  @@index([authorUserId])
  @@map("block_comments")
}

// ----------------------------------------------------------------------------
// 4. IDEAS DE CONTENIDO PRIVADAS DE LA AGENCIA (Secciones + Ideas en 3FN)
// ----------------------------------------------------------------------------

// Sección del banco de ideas. Su nombre no se repite dentro de la agencia.
model ContentIdeaSection {
  id        String   @id @default(uuid()) @db.VarChar(36)
  agencyId  String   @map("agency_id") @db.VarChar(36)
  name      String   @db.VarChar(100)
  color     String   @default("LIME") @db.VarChar(30)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ideas  ContentIdea[]

  @@unique([agencyId, name])
  @@index([agencyId, sortOrder])
  @@map("content_idea_sections")
}

// Idea de contenido privada de la agencia, opcionalmente asociada a un cliente.
model ContentIdea {
  id              String   @id @default(uuid()) @db.VarChar(36)
  agencyId        String   @map("agency_id") @db.VarChar(36)
  sectionId       String   @map("section_id") @db.VarChar(36)
  clientId        String?  @map("client_id") @db.VarChar(36)
  createdByUserId String   @map("created_by_user_id") @db.VarChar(36)
  title           String   @db.VarChar(180)
  content         String   @db.Text
  referenceUrl    String?  @map("reference_url") @db.VarChar(500)
  isPinned        Boolean  @default(false) @map("is_pinned")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agency        Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  section       ContentIdeaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser User               @relation("IdeaCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([agencyId, sectionId])
  @@index([agencyId, clientId])
  @@index([isPinned, createdAt])
  @@map("content_ideas")
}

/// Idea que un cliente le propone a su agencia. Al aceptarla se copia a ContentIdea.
model ClientIdeaProposal {
  id           String             @id @default(uuid()) @db.VarChar(36)
  agencyId     String             @map("agency_id") @db.VarChar(36)
  clientId     String             @map("client_id") @db.VarChar(36)
  title        String             @db.VarChar(180)
  content      String             @db.Text
  referenceUrl String?            @map("reference_url") @db.VarChar(500)
  status       IdeaProposalStatus @default(PENDING)
  respondedAt  DateTime?          @map("responded_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([clientId])
  @@map("client_idea_proposals")
}


// ----------------------------------------------------------------------------
// 5. NOTIFICACIONES Y LOGS DE AUDITORÍA
// ----------------------------------------------------------------------------

// Aviso interno para un usuario. referenceId apunta al recurso relacionado.
model Notification {
  id          String           @id @default(uuid()) @db.VarChar(36)
  userId      String           @map("user_id") @db.VarChar(36)
  type        NotificationType
  title       String           @db.VarChar(160)
  body        String           @db.Text
  referenceId String?          @map("reference_id") @db.VarChar(36)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// Evento de auditoría. Se conserva aunque se borre el usuario (userId pasa a null).
model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String?  @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 6. CONFIGURACIÓN EDITABLE EN TIEMPO DE EJECUCIÓN (solo valores no secretos)
// ----------------------------------------------------------------------------

// Ajuste editable: `key` es el nombre y `value` su valor en formato JSON.
model AppSetting {
  key             String   @id @db.VarChar(80)
  value           String   @db.Text
  updatedByUserId String?  @map("updated_by_user_id") @db.VarChar(36)
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("app_settings")
}
