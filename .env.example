# ============================================================================
# ContentSync — Variables de Entorno (.env.example)
# ============================================================================

# --- Servidor Backend ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3000

# --- Base de Datos Relacional (MySQL 8 / 9) ---
DATABASE_URL="mysql://root:tu_password@localhost:3306/contentsync"

# --- Cola de Trabajos y Programación (Redis 7 / BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Seguridad JWT y Cifrado de Tokens OAuth ---
JWT_ACCESS_SECRET=change_this_to_a_64_char_random_hex_secret_for_access_tokens_2026
JWT_REFRESH_SECRET=change_this_to_a_64_char_random_hex_secret_for_refresh_tokens_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Clave de 32 bytes (64 hex chars) para cifrado AES-256-GCM de tokens de Instagram/TikTok/YouTube en BD
OAUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Almacenamiento S3 Compatible (MinIO local / AWS S3 / Cloudflare R2) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/contentsync-videos
S3_REGION=us-east-1
S3_BUCKET=contentsync-videos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# --- Proveedores de Inicio de Sesión Social (Auth de Usuario en App) ---
GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FACEBOOK_AUTH_APP_ID=your-facebook-app-id
FACEBOOK_AUTH_APP_SECRET=your-facebook-app-secret
GITHUB_AUTH_CLIENT_ID=your-github-client-id
GITHUB_AUTH_CLIENT_SECRET=your-github-client-secret

# --- Envío de Correos Electrónicos (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-16-caracteres
SMTP_FROM="ContentSync <no-reply@contentsync.io>"

# --- Integraciones de Publicación Multiplataforma (OAuth de Clientes) ---
# Si MOCK_PLATFORMS=true, el sistema simula OAuth, subida y publicación sin requerir aprobación de Meta/TikTok/Google
MOCK_PLATFORMS=true

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/platforms/oauth/youtube/callback

# Instagram Graph API (Reels)
INSTAGRAM_APP_ID=your-meta-instagram-app-id
INSTAGRAM_APP_SECRET=your-meta-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/platforms/oauth/instagram/callback

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/platforms/oauth/tiktok/callback

# --- Notificaciones Push (Firebase Cloud Messaging) ---
FCM_MOCK_MODE=true
FCM_PROJECT_ID=contentsync-mobile
FCM_CLIENT_EMAIL=firebase-adminsdk@contentsync-mobile.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
