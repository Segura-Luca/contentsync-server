# ============================================================================
# ContentSync — Variables de entorno
# Copiá este archivo a backend/.env (o a .env en la raíz si usás Docker Compose).
#
# Aquí va la infraestructura y los secretos. El resto (límites por red, aprobación
# obligatoria, vigencia de códigos, reintentos, nombre de la app...) se edita sin
# reiniciar desde Ajustes, con una cuenta ADMIN_GENERAL.
#
# El servidor valida este archivo al arrancar. En producción no inicia si falta un
# secreto obligatorio o si conserva un valor de ejemplo.
# ============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# URL pública: correos, callbacks OAuth y descarga de videos por las redes. Obligatoria en producción.
PUBLIC_APP_URL=http://localhost:3000
# Orígenes externos autorizados (separados por coma). La SPA comparte origen: normalmente queda vacío.
CORS_ORIGIN=
# Orígenes adicionales permitidos por la CSP para conexiones del navegador.
CSP_EXTRA_CONNECT_SRC=
SWAGGER_ENABLED=true
# Peticiones por minuto e IP: general y en rutas sensibles (login, códigos, recuperación).
RATE_LIMIT_PER_MINUTE=200
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Base de datos: solo MySQL 8.0.16+ ---
DATABASE_URL="mysql://usuario:tu_password@localhost:3306/contentsync"

# Solo para docker-compose.yml
MYSQL_DATABASE=contentsync
MYSQL_USER=contentsync
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Sesiones y cifrado ---
# Generá cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Formato: 15m, 12h, 7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# --- Almacenamiento de fotos y videos ---
# Carpeta local de subidas. En la nube apuntala a un disco persistente. Vacío: backend/public/uploads/videos
UPLOAD_DIR=
# Supabase Free admite hasta 50 MB por archivo: usá UPLOAD_MAX_MB=50 con ese plan.
UPLOAD_MAX_MB=500

# S3 compatible (opcional: MinIO, AWS S3, Cloudflare R2)
# Con Supabase: S3_ENDPOINT=https://<proyecto>.storage.supabase.co/storage/v1/s3
# El bucket puede ser privado: los archivos se ven con enlaces firmados que vencen a las 12 horas.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contentsync-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Correo ---
# Dirección que se muestra como remitente en la app y en los correos.
MAIL_SENDER_ADDRESS=
# Orden de envío por tipo de correo: n8n, https, smtp. Los transportes sin credenciales se omiten.
MAIL_TRANSPORTS_OTP=n8n,https,smtp
MAIL_TRANSPORTS_GENERAL=n8n,https,smtp

N8N_WEBHOOK_URL=
# Opcional: se envía en la cabecera X-Webhook-Secret para que n8n rechace llamadas de terceros.
N8N_WEBHOOK_SECRET=

GMAIL_HTTPS_WEBHOOK_URL=
GMAIL_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Inicio de sesión social ---
GOOGLE_AUTH_CLIENT_ID=
FACEBOOK_AUTH_APP_ID=
FACEBOOK_AUTH_APP_SECRET=
META_GRAPH_VERSION=v20.0
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# --- Ajustes ---
SETTINGS_REFRESH_SECONDS=30

# --- Datos de demostración (npm run prisma:seed; se niega a correr en producción) ---
SEED_DEFAULT_PASSWORD=
SEED_OWNER_EMAIL=
